# 复制为 .env.local 使用（已被 gitignore）
# Vercel 上这些值配置在 Project Settings -> Environment Variables

# ---- 服务端 ----
# JWT 签名密钥（必填，随机长字符串；本地可随意填，生产务必强随机）
AUTH_SECRET=

# Turso 数据库（Vercel Marketplace 开通后自动注入；本地留空则用 ./local.db 文件库）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 允许跨域的前端来源，逗号分隔；同域部署（Vercel 默认形态）留空即可
CORS_ORIGIN=

# ---- 构建期（仅 Cloudflare Pages 分域部署时需要；Vercel 同域部署留空） ----
# VITE_API_BASE=https://your-worker.workers.dev
